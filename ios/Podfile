# CocoaPods is required as of the Face Capture Core: ML Kit's iOS SDK
# (GoogleMLKit/FaceDetection, pulled in by google_mlkit_face_detection)
# ships as a CocoaPods pod only, with no Swift Package Manager support.
# Every other plugin in this project still resolves through SPM; Flutter
# uses both side by side.
#
# 15.5 is ML Kit's minimum, and matches IPHONEOS_DEPLOYMENT_TARGET in
# Runner.xcodeproj. Keep the two in step.
platform :ios, '15.5'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

# Every build configuration has to be mapped, including the nine flavor
# ones (see "iOS Builds" in Instructions.md). Without this, CocoaPods
# cannot tell a flavored Release from a Debug and links the wrong
# configuration. **Add a line here whenever a flavor is added.**
project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
  'Debug-dev' => :debug,
  'Profile-dev' => :release,
  'Release-dev' => :release,
  'Debug-alpha' => :debug,
  'Profile-alpha' => :release,
  'Release-alpha' => :release,
  'Debug-prod' => :debug,
  'Profile-prod' => :release,
  'Release-prod' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))

  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)

    target.build_configurations.each do |config|
      # permission_handler compiles every permission handler into the
      # binary by default, which draws "missing purpose string"
      # warnings for permissions this app never asks for. Only the ones
      # listed here are compiled in — add a line when a new permission
      # is genuinely used, and add the matching Info.plist string.
      config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] ||= [
        '$(inherited)',
        'PERMISSION_CAMERA=1',
        'PERMISSION_LOCATION=1',
        'PERMISSION_PHOTOS=1',
      ]
    end
  end
end
